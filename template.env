# ============================================
# Google MCP Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# Note: .env is already in .gitignore and won't be committed

# ============================================
# Authentication Method 1: OAuth 2.0 (Recommended)
# ============================================
# Get these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Choose "Desktop app" as the application type

# Your Google OAuth Client ID
GOOGLE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Your Google OAuth Client Secret
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret-here

# Path to store OAuth tokens (JSON file)
# Can be anywhere on your system, e.g., ~/.google-mcp/tokens.json
GOOGLE_OAUTH_TOKEN_PATH=~/.google-mcp/tokens.json

# OAuth redirect URI (defaults to http://localhost:3001 if not set)
# Should match the redirect URI configured in Google Cloud Console
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001

# ============================================
# Authentication Method 2: Service Account
# ============================================
# Alternative to OAuth. Use either OAuth OR Service Account, not both.
# If using Service Account, comment out OAuth variables above and uncomment below:

# Service Account email from Google Cloud Console
# GOOGLE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Service Account private key (from JSON key file)
# Replace \n with actual newlines when setting this variable
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gmail user to impersonate (required for Service Account with domain-wide delegation)
# GMAIL_USER_TO_IMPERSONATE=user@yourdomain.com

# ============================================
# Transport Configuration
# ============================================
# This server runs in HTTP/WebSocket SERVER mode only
# To connect to external endpoints, use bridge.ts with MCP_ENDPOINT (see Bridge section)

# Server port for HTTP transport (defaults to 3000)
# Also used by OAuth callback server (defaults to 3001)
# PORT=3000

# ============================================
# HTTP Transport Security Settings
# ============================================
# All have defaults and can be left commented unless you need custom values

# Comma-separated list of allowed hosts (defaults to "localhost,127.0.0.1")
# Example: "localhost,127.0.0.1,your-domain.com"
# ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed CORS origins (defaults to "*" for all)
# Example: "http://localhost:3000,https://your-domain.com"
# ALLOWED_ORIGINS=*

# Enable DNS rebinding protection (defaults to "false")
# Set to "true" for production deployments
# ENABLE_DNS_REBINDING_PROTECTION=false

# ============================================
# WebSocket Authentication (for ESP32 clients)
# ============================================
# Following MCP_DESIGN.MD Security section (line 94): Bearer token authentication

# Bearer token for WebSocket authentication (optional)
# If set, clients must include: Authorization: Bearer <token>
# ESP32 clients can store this in NVS as per MCP_DESIGN.MD
# MCP_BEARER_TOKEN=your-secret-token-here

# Require Bearer token authentication for WebSocket connections (defaults to false)
# Set to "true" to enforce authentication; clients without valid token will be rejected
# MCP_REQUIRE_AUTH=false

# ============================================
# MCP Bridge Configuration (bridge.ts - Client Mode)
# ============================================
# REQUIRED for bridge mode: WebSocket endpoint URL that the bridge connects TO
# The bridge acts as a WebSocket CLIENT connecting to an external endpoint
# The bridge then spawns the MCP server in stdio mode and pipes messages
# Example: wss://api.xiaozhi.me/mcp/?token=eyJhbGci...
# See MCP_NODE_DESIGN.MD for details
# 
# Usage:
#   - Run bridge: pnpm run bridge
#   - Bridge connects to MCP_ENDPOINT as a WebSocket client
#   - Bridge spawns index.ts in stdio mode
#   - Messages flow: External Endpoint ←→ Bridge ←→ Stdio Server
#
# MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=your-token-here

# Bridge server name (for logging, defaults to "google-mcp")
# MCP_SERVER_NAME=google-mcp

# Enable debug logging for bridge (defaults to false, or true if NODE_ENV=development)
# DEBUG=false

# Bridge environment mode (development or production)
# In development: uses bun to run TypeScript directly
# In production: requires building first (bun run bun:build)
# NODE_ENV=development

# ============================================
# Optional: File Utilities
# ============================================
# Custom download directory (optional)
# If not set, uses system default Downloads folder
# XDG_DOWNLOAD_DIR=/path/to/downloads

# ============================================
# Optional: Testing Variables
# ============================================
# Used for running tests
# TEST_EMAIL=test@example.com

